#
# ImmortalWrt 25.12.x (Amlogic / N1) ImageBuilder Configuration
#

# ----------------------------------------------------
# 1. 目标平台与 CPU 架构 (N1/Amlogic 适配)
# ----------------------------------------------------
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_armsr_armv8_Default=y

# ----------------------------------------------------
# 2. 根文件系统与镜像格式
# ----------------------------------------------------
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# ----------------------------------------------------
# 3. 25.12 核心组件 (全面升级为 Firewall4 & Nftables)
# ----------------------------------------------------
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_dnsmasq-full=y

# ----------------------------------------------------
# 4. LuCI 基础框架与多语言支持 (25.12 统一语言选择)
# ----------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-light=y
CONFIG_LUCI_LANG_zh_Hans=y

# ----------------------------------------------------
# 5. 斐讯 N1 必需的存储与网卡驱动 (USB / 磁盘管理)
# ----------------------------------------------------
CONFIG_PACKAGE_autocore-arm=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-squashfs=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix88179=y

# ----------------------------------------------------
# 6. 常用 LuCI 工具与应用包
# ----------------------------------------------------
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-filebrowser=y

# ----------------------------------------------------
# 7. 显式禁用 24.10 旧版遗留/冲突依赖 (-/is not set)
# ----------------------------------------------------
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_iptables is not set
# CONFIG_PACKAGE_kmod-ipt-offload is not set
# CONFIG_PACKAGE_golang is not set
